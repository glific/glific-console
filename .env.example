# Every variable the app reads. All are optional.
#
# Local: copy to .env.local to override the committed defaults in .env.development / .env.test / .env.production.
# Vercel: add these under Project Settings -> Environment Variables (values there override the committed files).
#
# Everything prefixed VITE_ is compiled into the public JavaScript bundle. Never put a secret here.

# --- Backend -------------------------------------------------------------------------------------------------

# Backend origin. Unset in production: each NGO at <shortcode>.glific.com uses api.<shortcode>.glific.com.
# Set it for local dev (committed in .env.development) and for Vercel previews, whose *.vercel.app host has no API.
# Local: https://api.glific.test:4001   Vercel preview: your staging API, e.g. https://api.staging.glific.com
VITE_BACKEND_URL=

# Subdomain of the NGO host that serves the API. Only change it if the backend moves off api.<host>.
VITE_API_SUBDOMAIN=api

# --- Development only ---------------------------------------------------------------------------------------

# Answer API calls with MSW mocks instead of a backend (pnpm dev:mock sets it). Ignored in production builds.
VITE_ENABLE_MOCKS=false

# --- Internal pages -----------------------------------------------------------------------------------------

# Comma-separated hosts that serve /design-system (Glific admins only on top of this). Empty: nowhere.
# Production default (.env.production): prod.glific.com. Dev default: glific.test,localhost,127.0.0.1.
VITE_DESIGN_SYSTEM_HOSTS=

# --- Monitoring (unset: disabled) ---------------------------------------------------------------------------

# Sentry DSN, e.g. https://<key>@o<org>.ingest.sentry.io/<project>. Public by design.
VITE_SENTRY_DSN=
# PostHog project API key (phc_...). Public by design.
VITE_POSTHOG_KEY=
# PostHog ingestion host: https://us.i.posthog.com (default) or https://eu.i.posthog.com.
VITE_POSTHOG_HOST=https://us.i.posthog.com

# --- Build environment (Vercel / CI, not read by the app) ---------------------------------------------------

# Skips installing git hooks during `pnpm install` on Vercel.
# LEFTHOOK=0
