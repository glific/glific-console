# Copy to .env.local to override. Non-secret defaults live in .env.development / .env.test / .env.production.

# Backend origin, e.g. https://api.glific.test:4001. Unset: api.<host> (production) or the page's own origin on localhost.
VITE_BACKEND_URL=
# Subdomain of the NGO host that serves the API (api.<shortcode>.glific.com).
VITE_API_SUBDOMAIN=api
# Serve API responses from MSW handlers in src/mocks (dev only).
VITE_ENABLE_MOCKS=false
# Comma-separated hostnames that serve the internal /design-system page. Empty: nowhere.
VITE_DESIGN_SYSTEM_HOSTS=localhost
# Error tracking and product analytics. Unset: disabled.
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
