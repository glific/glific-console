# Copy to .env.local to override. Non-secret defaults for dev/test live in .env.development / .env.test.
# Base URL for API requests.
VITE_API_URL=/api
# Serve API responses from MSW handlers in src/mocks (dev only).
VITE_ENABLE_MOCKS=false
# Comma-separated hostnames that serve the internal /design-system page. Empty: nowhere.
VITE_DESIGN_SYSTEM_HOSTS=localhost
